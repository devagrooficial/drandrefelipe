---
import {
  DOCTOR_NAME,
  FULL_ADDRESS,
  MAPS_URL,
  NAV_LINKS,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from "../../lib/contact";

const year = new Date().getFullYear();
---

<footer id="contato" class="bg-primary-dark px-6 py-16 text-cream sm:px-10 lg:px-16">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-12 border-b border-cream/10 pb-12 md:grid-cols-3">
      <div>
        <img
          src="/images/logo-reversed.png"
          alt={DOCTOR_NAME}
          class="h-20 w-auto"
        />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/55">
          Ortopedia e traumatologia com foco em medicina regenerativa —
          cuidado técnico e humano em Cuiabá.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">
          Navegação
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-cream/70 transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">
          Contato
        </p>
        <address class="mt-4 space-y-3 text-sm not-italic text-cream/70">
          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="block transition-colors hover:text-accent"
          >
            {FULL_ADDRESS}
          </a>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="block transition-colors hover:text-accent"
          >
            {WHATSAPP_DISPLAY}
          </a>
        </address>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-cream/40 md:flex-row">
      <p>© {year} {DOCTOR_NAME}. Todos os direitos reservados.</p>
      <p>Cuiabá - MT</p>
    </div>
  </div>
</footer>
