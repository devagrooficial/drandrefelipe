---
import { WHATSAPP_URL } from "../../lib/contact";
---

<section id="top" data-scroll-video-container class="relative bg-primary lg:h-[400vh]">
  <div class="lg:sticky lg:top-0 lg:h-screen lg:overflow-hidden">
    <div class="mx-auto grid max-w-7xl grid-cols-1 lg:h-full lg:grid-cols-2">
      <!-- Left: copy -->
      <div
        class="relative z-10 flex flex-col justify-center px-6 pt-32 pb-16 sm:px-10 lg:px-12 lg:pt-24"
      >
        <p
          data-reveal="hero"
          class="mb-6 text-sm font-semibold tracking-[0.25em] text-accent uppercase"
        >
          Ortopedia &amp; Medicina Regenerativa
        </p>

        <h1
          data-reveal="hero"
          class="text-balance font-serif text-4xl font-semibold leading-[1.1] text-cream sm:text-5xl lg:text-6xl"
        >
          Voltar a se mover sem dor é possível.
        </h1>

        <p data-reveal="hero" class="mt-6 max-w-xl text-lg leading-relaxed text-cream/75">
          Em Cuiabá, o Dr. André Felipe Moura cuida de quem convive com dor
          crônica, lesões articulares e limitações de movimento — com um olhar
          técnico, atualizado e profundamente humano sobre cada caso.
        </p>

        <div data-reveal="hero" class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-accent px-8 py-4 text-sm font-semibold tracking-wide text-primary-dark transition-transform hover:scale-105 hover:bg-accent-light"
          >
            Agendar avaliação
          </a>
          <a
            href="#tratamentos"
            class="rounded-full border border-cream/25 px-8 py-4 text-sm font-semibold text-cream/90 transition-colors hover:border-accent hover:text-accent"
          >
            Conhecer tratamentos
          </a>
        </div>
      </div>

      <!-- Right: scroll-scrubbed video (progressão da artrose no joelho) -->
      <div data-scroll-video-trigger class="relative h-[60vh] overflow-hidden lg:h-auto">
        <video
          data-scroll-video
          muted
          playsinline
          preload="auto"
          class="h-full w-full object-cover"
        >
          <source src="/images/video3D.mp4" type="video/mp4" />
        </video>

        <!-- Blend seam so the video reads as part of the same scene as the
             text panel instead of a hard-edged second color block: fades
             from the panel's own background into the video. Direction
             flips with the layout — top edge when stacked on mobile,
             left edge once the two columns sit side by side. -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-primary to-transparent lg:hidden"
        ></div>
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 hidden w-32 bg-gradient-to-r from-primary to-transparent lg:block"
        ></div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div
      class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-cream/50 lg:flex"
    >
      <span class="text-[11px] tracking-[0.3em] uppercase">Explorar</span>
      <span class="scroll-cue h-9 w-px bg-cream/40"></span>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  gsap.to("[data-reveal='hero']", {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: "power3.out",
    stagger: 0.15,
    delay: 0.3,
  });
</script>

<!-- Scroll-bound video (Apple product-page technique): the video never
     autoplays — currentTime is driven strictly by scroll progress. Scrub
     math waits for the loadedmetadata event so `duration` is real before
     ScrollTrigger touches currentTime, avoiding a jump/stutter on first
     scroll.

     Desktop (lg+) pins the video in a sticky viewport-height box while a
     tall 400vh container scrolls behind it, exactly like an Apple
     product page. That pin math needs the video's own column to be
     ~60vh tall AND the copy column to fit in the same 100vh box — on
     phone-sized viewports the copy alone can already exceed 100vh, which
     would clip most of the video under the pin's overflow-hidden. So
     below lg, there's no pin at all: the section is normal height, and
     the video scrubs against its own position as it scrolls through the
     viewport like any other element — still driven by scroll, just not
     held in place first. -->
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector<HTMLElement>("[data-scroll-video-container]");
  const videoTrigger = document.querySelector<HTMLElement>("[data-scroll-video-trigger]");
  const video = document.querySelector<HTMLVideoElement>("[data-scroll-video]");

  function initScrollVideo() {
    if (!container || !videoTrigger || !video) return;
    if (!Number.isFinite(video.duration) || video.duration <= 0) return;

    const onUpdate = (self: ScrollTrigger) => {
      video.currentTime = self.progress * video.duration;
    };

    // A small scrub value lets GSAP ease toward the scroll-derived
    // progress instead of snapping to it on every event, absorbing
    // jittery wheel/trackpad deltas. The jump-cut feel itself came from
    // the source video having a keyframe roughly every 3.3s, so a seek
    // between keyframes had to decode forward first — fixed by
    // re-encoding with a keyframe every 2 frames.
    const mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      const trigger = ScrollTrigger.create({
        trigger: container,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.35,
        onUpdate,
      });
      return () => trigger.kill();
    });

    mm.add("(max-width: 1023.98px)", () => {
      const trigger = ScrollTrigger.create({
        trigger: videoTrigger,
        start: "top bottom",
        end: "bottom top",
        scrub: 0.35,
        onUpdate,
      });
      return () => trigger.kill();
    });
  }

  if (video) {
    if (video.readyState >= 1) {
      initScrollVideo();
    } else {
      video.addEventListener("loadedmetadata", initScrollVideo, { once: true });
    }
  }
</script>

<style>
  .scroll-cue {
    animation: scroll-cue 1.8s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes scroll-cue {
    0% {
      transform: scaleY(0);
      opacity: 0;
    }
    40% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(0);
      opacity: 0;
      transform-origin: bottom;
    }
  }
</style>
