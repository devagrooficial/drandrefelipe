---
import TreatmentsGrid from "../ui/TreatmentsGrid.tsx";
---

<section id="tratamentos" class="bg-cream px-6 py-24 sm:px-10 lg:px-16 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-accent-dark">
        Soluções e tratamentos
      </p>
      <h2 class="text-balance font-serif text-3xl font-semibold text-primary sm:text-4xl">
        Cuidado específico para cada dor
      </h2>
      <p class="mt-4 text-base leading-relaxed text-primary/70">
        Diagnóstico preciso e condutas atualizadas — cirúrgicas quando
        necessário, regenerativas sempre que possível.
      </p>
    </div>

    <div class="mt-16">
      <TreatmentsGrid client:visible />
    </div>
  </div>
</section>
