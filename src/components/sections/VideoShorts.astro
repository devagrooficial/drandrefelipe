---
import PlayGlyph from "../ui/PlayGlyph.astro";

// Fill `id` with a real YouTube video ID to make a card playable.
// Cards with an empty id render as a static "Em breve" placeholder —
// nothing is ever pointed at a guessed or invented video URL.
const videos = [
  { title: "Dor no joelho durante o treino", id: "H857GbsiHVA" },
  { title: "O poder da medicina regenerativa", id: "OgjC55HUY10" },
  { title: "Mitos e verdades sobre dor lombar", id: "" },
];
---

<section id="conteudo" class="bg-primary px-6 py-24 sm:px-10 lg:px-16 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <p data-reveal="up" class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-accent">
        Conhecimento em foco
      </p>
      <h2 data-reveal="up" class="text-balance font-serif text-3xl font-semibold text-cream sm:text-4xl">
        Conteúdo em vídeo, direto ao ponto
      </h2>
      <p data-reveal="up" class="mt-4 text-base leading-relaxed text-cream/65">
        Explicações curtas do Dr. André sobre dor, diagnóstico e tratamento
        — para entender antes mesmo da consulta.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        videos.map((video) => (
          <div
            data-reveal="up"
            data-video-card
            class="relative aspect-[9/16] overflow-hidden rounded-2xl bg-primary-light ring-1 ring-cream/10"
          >
            <div
              class="absolute inset-0"
              style="background: radial-gradient(circle at 30% 15%, rgba(200,173,132,0.32), transparent 55%), linear-gradient(160deg, #24352f 0%, #1a2825 60%, #0f1815 100%);"
            />

            {video.id ? (
              <button
                type="button"
                data-video-trigger
                data-video-id={video.id}
                data-video-title={video.title}
                aria-label={`Assistir: ${video.title}`}
                class="group absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-4 p-6 text-center"
              >
                <PlayGlyph />
                <span class="sr-only">Reproduzir vídeo</span>
              </button>
            ) : (
              <div class="absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-4 p-6 text-center">
                <PlayGlyph muted />
                <span class="rounded-full bg-cream/10 px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-cream/60 ring-1 ring-cream/20">
                  Em breve
                </span>
              </div>
            )}

            <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-primary-dark/95 to-transparent p-5 pt-12">
              <p class="text-sm font-medium text-cream">{video.title}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-video-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.videoId;
      const card = btn.closest<HTMLElement>("[data-video-card]");
      if (!id || !card) return;

      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.dataset.videoTitle ?? "Vídeo";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      iframe.style.border = "0";
      card.replaceChildren(iframe);
    });
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.to("#conteudo [data-reveal='up']", {
    opacity: 1,
    y: 0,
    duration: 0.9,
    ease: "power3.out",
    stagger: 0.1,
    scrollTrigger: {
      trigger: "#conteudo",
      start: "top 75%",
    },
  });
</script>
